#!/usr/bin/env python3
"""Estimate what summarizing subagents' logs into trees costs.

For each log (agents/<Name>.log of a chat directory) it prints its steps,
the messages they make, and the compactions a tree over them takes: one per
message over 512 bytes, one per merge whose two lines don't fit in one. A
model's line is taken as LINE bytes. It reads the logs only.

    tools/agent-mem-estimate [--per-call USD] [--jobs N] [--secs S] LOG...
"""

import argparse
import re

HEAD = re.compile(
    r"(?m)^(task|on|opt|user|agent|thinking|tool|echo|loop|compacted|cut)"
    r"(?:@(\d+)(?:#(\S+?))?)?: "
)
NODE_MAX = 512  # chat.go nodeMax
CLIP_MAX = 30_000  # chat.go clipMax: characters of one message
LINE = 480  # bytes of a line a model writes


def messages(text):
    """Sizes of the messages a log makes, as agentmem.go feeds them."""
    heads = [m for m in HEAD.finditer(text) if m.start() == 0 or text[: m.start()].endswith("\n\n")]
    sizes = []
    for j, m in enumerate(heads):
        end = heads[j + 1].start() if j + 1 < len(heads) else len(text)
        kind, body = m.group(1), text[m.end() : end].removesuffix("\n\n")
        if kind == "thinking":
            continue
        for i in range(0, max(len(body), 1), CLIP_MAX):
            sizes.append(len(kind) + 2 + len(body[i : i + CLIP_MAX].encode()))
    return sizes


def calls(sizes):
    """Compactions a whole tree over messages of these sizes takes."""
    n = 0
    level = []
    for s in sizes:
        if s > NODE_MAX:
            n += 1
            level.append(LINE)
        else:
            level.append(s)
    while len(level) > 1:
        up = []
        for a, b in zip(level[0::2], level[1::2]):
            if a + 1 + b > NODE_MAX:
                n += 1
                up.append(LINE)
            else:
                up.append(a + 1 + b)
        level = up
    return n


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("logs", nargs="+")
    p.add_argument("--per-call", type=float, default=0.0008, help="USD per compaction (default: a measured Haiku average)")
    p.add_argument("--jobs", type=int, default=2, help="compactions at once (-agent-jobs)")
    p.add_argument("--secs", type=float, default=6, help="seconds per compaction")
    a = p.parse_args()
    for path in a.logs:
        text = open(path, encoding="utf-8", errors="replace").read()
        sizes = messages(text)
        n = calls(sizes)
        mins = n * a.secs / a.jobs / 60
        print(f"{path}: {len(text)} chars, {len(sizes)} messages, {n} compactions, "
              f"~${n * a.per_call:.2f}, ~{mins:.0f} min at {a.jobs} at once")


if __name__ == "__main__":
    main()
